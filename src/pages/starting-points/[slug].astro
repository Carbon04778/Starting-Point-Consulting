---
/**
 * Article template — one page per published Starting Points post.
 *
 * Structure: Blueprints Page 08 (back link + meta, title + byline, lead image,
 * body, tags / share / keep reading). Copy: Master Copy §10. Byline: Handoff
 * §13, "By Darlene Erich, MBA, BSN, RN" on every article.
 *
 * RENDERED PER REQUEST so a publish is live immediately. Drafts and unknown
 * slugs 404 — RLS never returns a draft to the anon key in the first place.
 *
 * Body HTML comes from renderMarkdown(): Markdown → HTML → sanitised to the
 * handful of tags the template styles. Nothing an author types can inject
 * script or markup.
 *
 * DELIBERATELY ABSENT:
 *   - The end-of-article author bio Handoff §13 requires. No approved text
 *     exists for it (OPEN-QUESTIONS #40); it is not drafted here.
 *   - The end-of-article newsletter signup — pending.newsletter (hidden, not
 *     inert, per Darlene's round-2 decision).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { business } from '../../config/site.js';
import { getPublished, related, renderMarkdown, formatDate } from '../../lib/articles.js';
import { mediaUrl, currentAdmin } from '../../lib/supabase.js';

export const prerender = false;

const slug = Astro.params.slug ?? '';

/* Preview: the editor's "Preview" link adds ?preview=1. Only a signed-in
   ADMIN gets a different result — their own session client can read drafts
   under RLS. For anyone else the flag changes nothing: still published-only,
   still a 404 for a draft. */
let article = null;
let isPreview = false;
if (Astro.url.searchParams.has('preview')) {
  const { supabase, admin } = await currentAdmin(Astro);
  if (admin) {
    const { data } = await supabase.from('articles').select('*').eq('slug', slug).maybeSingle();
    article = data;
    isPreview = Boolean(data);
  }
}
if (!article) article = await getPublished(slug);
if (!article) return new Response(null, { status: 404 });

const bodyHtml = renderMarkdown(article.body_md);
const keepReading = await related(article, 3);
const leadSrc = mediaUrl(article.lead_image_path);
const date = formatDate(article.published_at);

const canonical = new URL(`/starting-points/${article.slug}`, Astro.site).href;
const shareText = encodeURIComponent(article.title);
const shareUrl = encodeURIComponent(canonical);

/* Handoff §13 "Structured data": Article on each post, real author linked to
   the Person; publisher is the site-wide organization. */
const structured = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.summary || undefined,
  datePublished: article.published_at,
  dateModified: article.updated_at,
  articleSection: article.category,
  keywords: article.tags?.length ? article.tags.join(', ') : undefined,
  ...(leadSrc ? { image: leadSrc } : {}),
  author: {
    '@type': 'Person',
    name: business.founder.name,
    jobTitle: business.founder.role,
    url: new URL('/about', Astro.site).href,
  },
  publisher: { '@id': `${Astro.site}#organization` },
  mainEntityOfPage: canonical,
};

// Handoff §13 says descriptions are 150–160 characters; the summary is the
// closest approved text an article has. Trimmed, never padded.
const description = (article.summary || article.title).slice(0, 160);

Astro.response.headers.set(
  'Cache-Control',
  isPreview ? 'private, no-store' : 'public, s-maxage=60, stale-while-revalidate=300',
);
---

<BaseLayout title={`${article.title} | ${business.name}`} description={description} noindex={isPreview}>
  <script slot="head" is:inline set:html={JSON.stringify(structured)} type="application/ld+json" />

  {
    isPreview && (
      <p class="article-preview-bar" role="status">
        Preview — {article.status === 'published' ? 'this is the live version' : 'this draft is not visible to visitors'}.{' '}
        <a href={`/admin/articles/${article.id}`}>Back to the editor</a>
      </p>
    )
  }

  {/* 1 · Back link + meta — 2 · Title + byline */}
  <header class="section section--hero section--cream article-head">
    <div class="container article-head__inner">
      <a class="article-head__back" href="/starting-points">
        <Icon name="arrow-left" size={16} /> All Starting Points
      </a>
      <p class="article-head__meta">
        <span class="article-head__badge">{article.category}</span>
        <span class="article-head__kicker">
          {article.read_minutes} min read{date && ` · ${date}`}
        </span>
      </p>
      <h1 class="article-head__title">{article.title}</h1>
      <p class="article-head__byline">
        <img
          class="article-head__avatar"
          src="/assets/photos/darlene-erich-headshot-square.png"
          alt=""
          width="44"
          height="44"
          decoding="async"
        />
        <span>
          <span class="article-head__author">By {business.founder.name}</span>
          <span class="article-head__role">{business.founder.role}</span>
        </span>
      </p>
    </div>
  </header>

  {/* 3 · Lead image — 16:8, container-md, 28px radius */}
  <div class="container article-lead">
    {
      leadSrc ? (
        <img class="article-lead__img" src={leadSrc} alt={article.lead_image_alt ?? ''} decoding="async" />
      ) : (
        <div class="article-lead__img article-lead__img--tone" aria-hidden="true" />
      )
    }
  </div>

  {/* 4 · Body — 680px measure */}
  <article class="container article-body">
    {article.lead && <p class="article-body__lead">{article.lead}</p>}
    <div class="article-prose" set:html={bodyHtml} />

    {/* 5 · Tags + share */}
    <footer class="article-foot">
      {
        article.tags?.length > 0 && (
          <ul class="article-foot__tags" aria-label="Topics">
            {article.tags.map((tag) => (
              <li class="article-foot__tag">{tag}</li>
            ))}
          </ul>
        )
      }
      <div class="article-foot__share">
        <span class="article-foot__share-label">Share</span>
        <a
          class="article-foot__share-btn"
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on LinkedIn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
        </a>
        <a
          class="article-foot__share-btn"
          href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}&quote=${shareText}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on Facebook"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
        </a>
        <button class="article-foot__share-btn" type="button" data-copy-link={canonical} aria-label="Copy link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </button>
        <span class="article-foot__copied" role="status" aria-live="polite"></span>
      </div>
    </footer>
  </article>

  {/* 5 · Keep reading */}
  {
    keepReading.length > 0 && (
      <section class="section section--cream">
        <div class="container">
          <h2 class="eyebrow eyebrow--sage">Keep reading</h2>
          <div class="grid grid--3 article-related">
            {keepReading.map((a) => (
              <ArticleCard article={a} compact />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  // Copy-link: progressive — the button exists without JS, and does nothing
  // harmful; with JS it copies and confirms in words.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const status = button.parentElement?.querySelector<HTMLElement>('.article-foot__copied');
      try {
        await navigator.clipboard.writeText(button.dataset.copyLink ?? location.href);
        if (status) status.textContent = 'Link copied';
      } catch {
        if (status) status.textContent = 'Press Ctrl+C to copy';
      }
      window.setTimeout(() => {
        if (status) status.textContent = '';
      }, 2500);
    });
  });
</script>

<style>
  .article-preview-bar {
    margin: 0;
    padding: 10px var(--gutter);
    background: var(--gold-50);
    border-bottom: 1px solid var(--gold-100);
    font-size: var(--text-sm);
    text-align: center;
  }

  .article-head__inner {
    max-width: var(--container-md);
  }

  .article-head__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--gold-700);
    margin-bottom: 24px;
  }

  .article-head__meta {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: 0 0 18px;
  }

  .article-head__badge {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--gold-50);
    color: var(--gold-700);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
  }

  .article-head__kicker {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Blueprints Page 08 §2: H1 at 47px. */
  .article-head__title {
    font-size: clamp(2rem, 4vw, var(--text-3xl));
    line-height: 1.1;
    max-width: 20ch;
    margin: 0;
  }

  .article-head__byline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 28px 0 0;
  }

  .article-head__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }

  .article-head__author {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: 15px;
    color: var(--text-strong);
  }

  .article-head__role {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .article-lead {
    max-width: var(--container-md);
    margin-top: -8px;
  }

  .article-lead__img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  .article-lead__img--tone {
    background: linear-gradient(150deg, var(--gold-200), var(--gold-500) 70%, var(--gold-700));
  }

  /* Blueprints Page 08 §4: single column, 680px max, 18px at 1.68. */
  .article-body {
    max-width: calc(680px + 2 * var(--gutter));
    padding-top: 48px;
    padding-bottom: 8px;
  }

  .article-body__lead {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.5;
    color: var(--ink-700);
    margin: 0 0 28px;
  }

  .article-prose {
    font-size: var(--text-md);
    line-height: 1.68;
    color: var(--text-body);
  }

  .article-prose :global(p) {
    margin: 0 0 22px;
  }

  .article-prose :global(h2),
  .article-prose :global(h3) {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    color: var(--text-strong);
    margin: 36px 0 14px;
  }

  .article-prose :global(h2) {
    font-size: var(--text-xl);
  }

  .article-prose :global(h3) {
    font-size: var(--text-lg);
  }

  /* Lists with gold Check bullets (Blueprints §4). */
  .article-prose :global(ul) {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
  }

  .article-prose :global(ul > li) {
    position: relative;
    padding-left: 30px;
    margin-bottom: 10px;
  }

  .article-prose :global(ul > li)::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.42em;
    width: 12px;
    height: 7px;
    border-left: 2px solid var(--gold-500);
    border-bottom: 2px solid var(--gold-500);
    transform: rotate(-45deg);
  }

  .article-prose :global(ol) {
    margin: 0 0 22px;
    padding-left: 24px;
  }

  .article-prose :global(ol > li) {
    margin-bottom: 10px;
  }

  /* One Newsreader-italic pull quote, gold left hairline. */
  .article-prose :global(blockquote) {
    margin: 30px 0;
    padding: 6px 0 6px 26px;
    border-left: 3px solid var(--gold-500);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.45;
    color: var(--ink-700);
  }

  .article-prose :global(blockquote p) {
    margin: 0;
  }

  .article-prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--hairline);
    margin: 32px 0;
  }

  .article-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
  }

  .article-foot__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-foot__tag {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--sage-50);
    color: var(--sage-700);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--fw-medium);
  }

  .article-foot__share {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .article-foot__share-label {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .article-foot__share-btn {
    display: inline-flex;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border-default);
    background: transparent;
    align-items: center;
    justify-content: center;
    color: var(--ink-600);
    cursor: pointer;
    transition:
      border-color var(--t-fast) var(--ease-out),
      color var(--t-fast) var(--ease-out);
  }

  .article-foot__share-btn:hover,
  .article-foot__share-btn:focus-visible {
    border-color: var(--gold-300);
    color: var(--gold-700);
  }

  .article-foot__copied {
    font-size: var(--text-sm);
    color: var(--sage-700);
    min-width: 7ch;
  }

  .article-related {
    margin-top: 24px;
  }
</style>
