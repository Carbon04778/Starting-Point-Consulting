---
/**
 * Client Service Agreement acceptance — the step before payment.
 *
 * One page per paid offering, seven in total. These are the destinations the
 * Individual Sessions buttons have been pointing at all along: CLAUDE.md
 * requires that a purchase cannot begin until the agreement has been actively
 * accepted and that acceptance logged, so service buttons deliberately never
 * link straight to Stripe.
 *
 * NOT THE PROTOTYPE'S CHECKOUT SCREEN. `Checkout.jsx` in the mockup is a
 * visual mock of Stripe's own hosted page and says so at the top: "IN
 * PRODUCTION THIS PAGE DOES NOT EXIST." Card details are collected by Stripe,
 * never here, and nothing on this page touches payment information. What is
 * borrowed from the prototype is its progress row and order summary, which
 * Blueprints Page 06 §2 asks to be shown on every step.
 *
 * The progress row carries FOUR steps where the blueprint describes three
 * (Pay → Choose your time → Confirmed). The blueprint's row was drawn for a
 * flow that went straight to Stripe; CLAUDE.md's required agreement step comes
 * before all three, and hiding it would tell the visitor they are one step
 * further along than they are. Recorded in OPEN-QUESTIONS.
 *
 * `noindex`: these are transaction-flow utility pages, not marketing pages.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { business, routes, stripeLinks } from '../../config/site.js';
import { getLegalPage } from '../../lib/legal.js';
import { AGREEMENT_VERSION } from '../../lib/agreement.js';

export function getStaticPaths() {
  return stripeLinks.map((service) => ({
    params: { service: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const agreement = getLegalPage('client-service-agreement');

/* Surfaced by the endpoint on the way back when something went wrong. Each
   message says what happened and what the visitor should do next; none of
   them blame the visitor for a fault on our side. */
const ERRORS = {
  incomplete: 'Please add your name and email, and tick the box to confirm you agree.',
  'not-recorded':
    'We could not record your agreement, so we have not taken you to payment. Nothing has been charged. Please try again, or contact us and we will sort it out.',
  'unknown-service': 'We could not tell which session that was. Please choose it again.',
  malformed: 'Something went wrong with that submission. Please try again.',
};
const error = ERRORS[Astro.url.searchParams.get('error') ?? ''] ?? null;

/* Blueprints Page 06 §2: packages say "Schedule session 1" where single
   sessions say "Choose your time". */
const steps = [
  'Agree',
  'Pay',
  service.isPackage ? 'Schedule session 1' : 'Choose your time',
  'Confirmed',
];
const currentStep = 0;
---

<BaseLayout
  title={`Client Service Agreement — ${service.name} | ${business.name}`}
  description="Review and accept the Client Service Agreement before payment."
  noindex
>
  <section class="section checkout">
    <div class="container checkout__inner">
      {/* Progress row — Blueprints Page 06 §2 */}
      <ol class="steps" aria-label="Progress">
        {
          steps.map((label, i) => (
            <li
              class:list={[
                'steps__item',
                { 'steps__item--done': i < currentStep, 'steps__item--now': i === currentStep },
              ]}
              aria-current={i === currentStep ? 'step' : undefined}
            >
              <span class="steps__mark">
                {i < currentStep ? <Icon name="check" size={13} /> : i + 1}
              </span>
              <span class="steps__label">{label}</span>
            </li>
          ))
        }
      </ol>

      <div class="checkout__grid">
        <div>
          <p class="eyebrow">Before you pay</p>
          <h1>Review and accept the agreement</h1>
          <p class="t-lead checkout__lead">
            This is the agreement for your session. Read it, add your details, and we will take you
            to Stripe to pay. Nothing is charged until you get there.
          </p>

          {
            error && (
              <p class="checkout__error" role="alert">
                {error}
              </p>
            )
          }

          {/* The full approved agreement, from the same source the public
              /client-service-agreement page renders. Never summarised — a
              person cannot agree to text they were not shown. */}
          <div class="agreement" tabindex="0" role="region" aria-label="Client Service Agreement">
            <h2 class="agreement__title">{agreement.title}</h2>
            {agreement.lastUpdated && <p class="agreement__meta">{agreement.lastUpdated}</p>}
            {
              agreement.blocks.map((block) => {
                if (block.type === 'h2') return <h3>{block.text}</h3>;
                if (block.type === 'ul') {
                  return (
                    <ul>
                      {block.items.map((item) => (
                        <li set:html={item} />
                      ))}
                    </ul>
                  );
                }
                if (block.type === 'callout')
                  return <aside class="agreement__callout" set:html={block.html} />;
                return <p set:html={block.html} />;
              })
            }
          </div>

          <p class="checkout__version">
            You can also <a href={routes.clientServiceAgreement}>open the agreement on its own page</a>.
            Version {AGREEMENT_VERSION}.
          </p>
        </div>

        <aside class="checkout__side">
          <div class="card checkout__summary">
            <h2 class="checkout__summary-title">Your session</h2>

            <div class="checkout__line">
              <span>{service.name}</span>
              <span class="checkout__price">${service.price}</span>
            </div>

            {
              service.isPackage && (
                <p class="checkout__note">
                  Paid once. Your first session is scheduled straight after payment; the rest are
                  booked later with no further charge.
                </p>
              )
            }

            <div class="checkout__total">
              <span>Total</span>
              <span class="checkout__price">${service.price}</span>
            </div>

            {/* A real form POST, so the purchase path survives JavaScript
                being blocked. The endpoint writes the acceptance and then
                redirects to Stripe; the Stripe URL is resolved server-side
                and is deliberately not present in this markup. */}
            <form method="POST" action="/api/csa-acceptance" class="checkout__form">
              <input type="hidden" name="service_id" value={service.id} />

              <div class="field">
                <label for="full_name">Full name</label>
                <input type="text" id="full_name" name="full_name" required autocomplete="name" />
              </div>

              <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required autocomplete="email" />
              </div>

              <div class="field field--check">
                <input type="checkbox" id="agree" name="agree" required />
                <label for="agree">
                  I have read and agree to the Client Service Agreement.
                </label>
              </div>

              <button class="btn btn--primary checkout__submit" type="submit">
                Agree and continue to payment
              </button>

              <p class="btn-note">
                You will be taken to Stripe to pay by card. We never see or store your card details.
              </p>
            </form>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .checkout {
    background: var(--surface-page);
  }

  .checkout__inner {
    max-width: var(--container-lg);
  }

  /* Progress row — prototype Checkout.jsx */
  .steps {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-bottom: 36px;
  }

  .steps__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--heading-font);
    font-size: 0.8125rem;
    color: var(--text-subtle);
  }

  .steps__mark {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 50%;
    border: 1.5px solid var(--border-default);
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
  }

  .steps__item--done .steps__mark {
    background: var(--gold-500);
    border-color: var(--gold-500);
    color: var(--ink-900);
  }

  .steps__item--done .steps__label,
  .steps__item--now .steps__label {
    color: var(--text-strong);
  }

  .steps__item--now .steps__mark {
    border-color: var(--gold-500);
    color: var(--gold-700);
  }

  .steps__item--now .steps__label {
    font-weight: var(--fw-semibold);
  }

  .checkout__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 44px;
    align-items: start;
  }

  .checkout__lead {
    margin-top: 14px;
    max-width: 56ch;
  }

  .checkout__error {
    margin-top: 20px;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: var(--danger-50);
    border: 1px solid var(--danger-500);
    color: var(--ink-800);
    line-height: 1.55;
  }

  /* A bounded, scrollable copy of the agreement. Focusable and given a role so
     a keyboard or screen-reader user can scroll it like any other region. */
  .agreement {
    margin-top: 24px;
    max-height: 460px;
    overflow-y: auto;
    padding: 26px 28px;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
  }

  .agreement:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .agreement__title {
    font-size: var(--text-lg);
  }

  .agreement__meta {
    margin-top: 4px;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .agreement :global(h3) {
    margin-top: 22px;
    font-size: var(--text-md);
  }

  .agreement :global(p),
  .agreement :global(li) {
    margin-top: 10px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .agreement :global(ul) {
    margin-top: 6px;
    padding-left: 20px;
    list-style: disc;
  }

  .agreement__callout {
    margin-top: 16px;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: var(--gold-50);
    border: 1px solid var(--gold-200);
    line-height: 1.6;
  }

  .checkout__version {
    margin-top: 12px;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* Order summary ------------------------------------------------------ */

  .checkout__side {
    position: sticky;
    top: calc(var(--header-h) + 20px);
  }

  .checkout__summary-title {
    font-size: var(--text-md);
  }

  .checkout__line,
  .checkout__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    line-height: 1.5;
  }

  .checkout__total {
    margin-top: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--heading-font);
    font-weight: var(--fw-semibold);
    color: var(--text-strong);
  }

  .checkout__price {
    font-family: var(--heading-font);
    font-weight: var(--fw-semibold);
    color: var(--text-strong);
    white-space: nowrap;
  }

  .checkout__note {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .checkout__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 8px;
  }

  .field--check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    align-items: start;
  }

  .field--check input {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    accent-color: var(--gold-500);
  }

  .field--check label {
    line-height: 1.5;
    color: var(--text-body);
  }

  .checkout__submit {
    width: 100%;
  }

  @media (max-width: 900px) {
    .checkout__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .checkout__side {
      position: static;
    }
  }
</style>
