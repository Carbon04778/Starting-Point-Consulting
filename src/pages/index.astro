---
/**
 * Home — Blueprints Page 01, Master Website Copy §02.
 *
 * Section order is fixed by the blueprint:
 *   1 Hero  2 Our approach band  3 Who it's for  4 How we partner  5 Let's begin
 *
 * HERO COPY CONFLICT, resolved in favour of the Handoff — see
 * docs/OPEN-QUESTIONS.md. Handoff §07 gives an "approved hierarchy, in this
 * order" for the hero whose eyebrow and supporting sentence differ from Master
 * Copy §02. The Handoff outranks Master Copy in CLAUDE.md's source-of-truth
 * order, and §13 independently requires the declarative "Starting Point
 * Consulting provides…" sentence high on the homepage, so the Handoff version
 * is placed here. Flagged for Darlene because it is the most visible copy on
 * the site.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactPanel from '../components/ContactPanel.astro';
import { routes } from '../config/site.js';
import {
  serviceCards,
  integrationFeature,
  integrationScopeDisclaimer,
  whoWeServe,
} from '../copy/shared.js';

/* Master Copy §02 — "Our approach band". */
const pillars = [
  { name: 'Understand', body: 'Understanding stress, ourselves, and one another.' },
  { name: 'Connect', body: 'Building healthier relationships, teams, and communities.' },
  { name: 'Grow', body: 'Developing resilience, leadership, awareness, and capacity.' },
  { name: 'Thrive', body: 'Creating sustainable well-being for people and systems.' },
];

/* Master Copy §02 — "Who it's for". */
const paths = [
  {
    eyebrow: 'For individuals',
    heading: 'Seeking support for yourself?',
    body: 'Whether you found us on your own or were referred by a therapist or provider, you are welcome here. We offer one-to-one learning and resilience work that meets you exactly where you are, with no diagnosis or referral required.',
    button: { label: 'Start where you are', href: routes.individualSessions, variant: 'primary' },
    plate: 'gold',
    icon: 'heart',
  },
  {
    eyebrow: 'For teams & organizations',
    heading: 'Leading a team, school, or system?',
    body: 'We partner with healthcare teams, first responders, schools, and organizations to build healthier, more resilient cultures of working, learning, and care.',
    button: { label: 'Explore our work', href: routes.services, variant: 'secondary' },
    plate: 'sage',
    icon: 'users',
  },
];
---

<BaseLayout
  title="Starting Point Consulting | Nervous System Education"
  description="Nervous system education, somatic practice, and resilience training for individuals, healthcare teams, first responders, and organizations. Utah based, nationwide."
>
  {/* 1 · Hero — cream base with a sunrise wash and a gold corner glow. */}
  <section class="section section--hero hero">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">Nervous System Regulation · Well-Being · Lasting Change</p>
        <h1>Helping people and systems thrive in a complex world.</h1>
        <p class="t-lead hero__lead">
          Starting Point Consulting provides nervous system education, somatic practice, and
          resilience and well-being programs for individuals, healthcare teams, first responders,
          educators, leaders, and organizations. Based in Utah, working virtually and on site
          nationwide.
        </p>
        <div class="button-row hero__actions">
          <a class="btn btn--primary" href={routes.individualSessions}>Start where you are</a>
          <a class="btn btn--secondary" href={routes.services}>Explore our work</a>
        </div>
      </div>

      {/* Image Map HOME-01. The hero photograph is a pending item, so the
          emblem medallion stands in — Blueprints Page 01 §1 specifies exactly
          this, and Pending Items forbids filling the slot with stock.

          The medallion is the prototype's: a blurred gold-200 radial glow
          behind a 340px white disc with shadow-lg and a hairline border,
          holding the emblem at 250px. */}
      <div class="hero__medallion">
        <span class="hero__glow" aria-hidden="true"></span>
        <span class="hero__disc">
          <img
            src="/assets/logo/starting-point-emblem-940x1000.svg"
            alt=""
            width="250"
            height="266"
            decoding="async"
          />
        </span>
      </div>
    </div>
  </section>

  {/* 2 · Our approach band — white cards on cream, centred header. */}
  <section class="section section--cream">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--centred">Our approach</p>
        <h2>Where science meets humanity and meaningful change becomes possible.</h2>
      </div>

      <div class="grid grid--4 section-head__after">
        {
          pillars.map((pillar) => (
            <article class="card card--equal">
              <h3>{pillar.name}</h3>
              <p class="card__body">{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 3 · Who it's for — warm sand, centred header, two wide cards. */}
  <section class="section section--sand">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--centred">Who it's for</p>
        <h2>Two paths, one starting point.</h2>
        <p class="who__lead">
          This work is for anyone carrying more than they were meant to carry alone, whether one
          person or a whole system.
        </p>
      </div>

      <div class="grid grid--2 section-head__after">
        {
          paths.map((path) => (
            <article class="card card--equal">
              {/* Blueprints Page 01 §3: Card A gold plate + Heart, Card B sage
                  plate + Users. */}
              <span class:list={['icon-plate', `icon-plate--${path.plate}`]}>
                <Icon name={path.icon} size={22} />
              </span>
              <p class="card-eyebrow">{path.eyebrow}</p>
              <h3>{path.heading}</h3>
              <p class="card__body">{path.body}</p>
              <div class="card__foot">
                <a class:list={['btn', `btn--${path.button.variant}`]} href={path.button.href}>
                  {path.button.label}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 4 · How we partner — services grid, feature card, audience chips. */}
  <section class="section section--cream">
    <div class="container">
      <p class="eyebrow">Support for every starting point</p>
      <h2>How we partner</h2>
      <p class="t-lead section-lead">
        From individuals to whole systems, neuroscience-informed education, leadership, and
        programs that turn complex science into practical, human tools.
      </p>

      {/* No anchor ids on these cards — the footer's "How we partner" links
          point at the Services page, which is where those sections live. */}
      <div class="grid grid--3 section-head__after">
        {
          serviceCards.map((service) => (
            <article class="card card--equal">
              <span class:list={['icon-plate', `icon-plate--${service.tone}`]}>
                <Icon name={service.icon} size={22} />
              </span>
              <h3>{service.title}</h3>
              <p class="card__body">{service.body}</p>
              {service.href && (
                <div class="card__foot">
                  <a class="btn btn--text" href={service.href}>
                    Explore {service.title} <Icon name="arrow-right" size={18} />
                  </a>
                </div>
              )}
            </article>
          ))
        }
      </div>

      {/* Transformation & Integration Support feature card. Laid out exactly as
          the prototype's Services.jsx: two columns, gold-washed gradient panel,
          Route icon on a white plate beside the eyebrow and title, gold dot
          bullets on the right, the scope disclaimer under a hairline below them.
          Blueprints Page 02 §3 calls it the "Speaking & Consulting" card and
          describes a pill badge; both are stale — see OPEN-QUESTIONS #10. */}
      <article class="feature-card">
        <div>
          <div class="feature-card__head">
            <span class="feature-card__plate">
              <Icon name="route" size={23} />
            </span>
            <div>
              <p class="eyebrow">{integrationFeature.badge}</p>
              <h3 class="feature-card__title">{integrationFeature.title}</h3>
            </div>
          </div>
          <p class="feature-card__sub">{integrationFeature.subheading}</p>
          <p class="feature-card__body">{integrationFeature.body}</p>
        </div>

        <div>
          <ul class="feature-card__list">
            {integrationFeature.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
          {/* Must appear in full — Legal Pages Index §03. */}
          <p class="feature-card__scope">{integrationScopeDisclaimer}</p>
        </div>
      </article>

      {/* Who we serve. The prototype opens this group with a sage eyebrow, not
          a heading; it is marked up as an h2 carrying the eyebrow's styling so
          the page outline still names the group. */}
      <div class="who-we-serve">
        <h2 class="eyebrow eyebrow--sage">{whoWeServe.heading}</h2>
        <p class="who-we-serve__lead">{whoWeServe.body}</p>
        <div class="chip-row who-we-serve__chips">
          {whoWeServe.chips.map((chip) => <span class="chip chip--static">{chip}</span>)}
        </div>
      </div>
    </div>
  </section>

  {/* 5 · Let's begin */}
  <ContactPanel />
</BaseLayout>


<style>
  /* ------------------------------------------------------------------ */
  /* 1 · Hero — every value from the prototype's Hero.jsx.               */
  /* ------------------------------------------------------------------ */

  /* Prototype: linear-gradient(160deg, sand-100 0%, gold-50 60%, sand-200 100%).
     Blueprints Page 01 §1 describes a vertical cream → gold-50 wash with a gold
     corner glow; the prototype has neither the vertical axis nor the glow, and
     the Blueprints defer to it. */
  .hero {
    background: linear-gradient(160deg, var(--sand-100) 0%, var(--gold-50) 60%, var(--sand-200) 100%);
    border-top: 0;
    /* Prototype: padding '88px 40px 96px'. */
    padding-block: 88px 96px;
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }

  /* Prototype: clamp(40px, 5vw, 68px), lh 1.05, 20px under the eyebrow. */
  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    line-height: 1.05;
    margin-top: 20px;
  }

  .hero .eyebrow {
    margin-bottom: 0;
  }

  /* Prototype: Newsreader, text-lg, lh 1.5, ink-700, 540px measure, 24px down. */
  .hero__lead {
    max-width: 540px;
    margin-top: 24px;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink-700);
  }

  .hero__actions {
    gap: 14px;
    margin-top: 32px;
  }

  .hero__medallion {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* Prototype: 360px gold-200 radial glow, 8px blur, offset 10px above the disc. */
  .hero__glow {
    position: absolute;
    top: -10px;
    width: 360px;
    height: 360px;
    max-width: 100%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, var(--gold-200), transparent 70%);
    filter: blur(8px);
  }

  /* Prototype: 340px white disc, shadow-lg, 1px border-subtle. */
  .hero__disc {
    position: relative;
    display: grid;
    place-items: center;
    width: 340px;
    height: 340px;
    max-width: 100%;
    border-radius: 50%;
    background: var(--white);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border-subtle);
  }

  .hero__disc img {
    width: 250px;
    max-width: 74%;
    height: auto;
  }

  /* ------------------------------------------------------------------ */
  /* 2–3 · Centred section headers                                       */
  /* ------------------------------------------------------------------ */

  .section-head {
    max-width: var(--measure-lead);
    margin-inline: auto;
    text-align: center;
  }

  .eyebrow--centred {
    justify-content: center;
  }

  .who__lead {
    max-width: 560px;
    margin: 12px auto 0;
    color: var(--text-muted);
  }

  .section-lead {
    margin-top: 12px;
  }

  .section-head__after {
    margin-top: 44px;
  }

  .card-eyebrow {
    font-family: var(--heading-font);
    font-weight: var(--fw-medium);
    font-size: var(--text-xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-accent);
  }

  /* ------------------------------------------------------------------ */
  /* 4 · Transformation & Integration Support feature card               */
  /* Prototype Services.jsx: two columns 1.05fr/0.95fr, gap 40, aligned  */
  /* to the top, 38px/40px padding, radius-xl, border-subtle, shadow-sm, */
  /* on a 150deg sand-100 → gold-50 70% → sand-100 gradient.             */
  /* ------------------------------------------------------------------ */

  .feature-card {
    margin-top: var(--grid-gap);
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 40px;
    align-items: start;
    padding: 38px 40px;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: linear-gradient(150deg, var(--sand-100), var(--gold-50) 70%, var(--sand-100));
    box-shadow: var(--shadow-sm);
  }

  .feature-card__head {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Prototype: 48px white plate, radius-md, gold-700 glyph, shadow-sm. */
  .feature-card__plate {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--surface-card);
    color: var(--gold-700);
    box-shadow: var(--shadow-sm);
  }

  .feature-card__head .eyebrow {
    margin-bottom: 0;
  }

  .feature-card__title {
    margin-top: 6px;
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
  }

  .feature-card__sub {
    margin-top: 20px;
    font-family: var(--lead-font);
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--sage-700);
  }

  .feature-card__body {
    margin-top: 14px;
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--text-body);
  }

  /* Prototype: 11px gold-500 dots, not check icons; 14px apart. */
  .feature-card__list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .feature-card__list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--text-body);
  }

  .feature-card__list li::before {
    content: '';
    flex: none;
    width: 11px;
    height: 11px;
    margin-top: 7px;
    border-radius: 50%;
    background: var(--gold-500);
  }

  .feature-card__scope {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.84375rem; /* prototype: 13.5px */
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* ------------------------------------------------------------------ */
  /* 4 · Who we serve — prototype: 56px above, no rule, 620px measure.   */
  /* ------------------------------------------------------------------ */

  .who-we-serve {
    margin-top: 56px;
  }

  .who-we-serve__lead {
    max-width: 620px;
    margin-top: 12px;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .who-we-serve__chips {
    margin-top: 18px;
  }

  /* ------------------------------------------------------------------ */
  /* Mobile — Blueprints Page 01 "Mobile"                                */
  /* ------------------------------------------------------------------ */

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    /* The medallion sits below the buttons. */
    .hero__medallion {
      order: 2;
    }

    .hero__disc {
      width: 260px;
      height: 260px;
    }

    .hero__glow {
      width: 280px;
      height: 280px;
    }

    .feature-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-block: 56px 64px;
    }

    .section-head__after {
      margin-top: 28px;
    }

    .feature-card {
      padding: var(--card-pad-mobile);
    }
  }
</style>
