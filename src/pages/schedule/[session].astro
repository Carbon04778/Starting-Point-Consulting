---
/**
 * The three private post-payment scheduling pages.
 *
 * CLAUDE.md: "The three private scheduling pages are noindex, not in nav, only
 * reachable via a successful Stripe redirect." They are the step between
 * paying and having a time booked.
 *
 * WHY THREE AND NOT FIVE. Blueprints Page 06 contradicts itself — "one per
 * scheduling destination, five total" in §3, then "Three private post-payment
 * scheduling pages are required, covering all seven live Stripe links" at the
 * end. Master Copy §08 settles it by supplying approved copy for exactly
 * three, and labelling the 60-minute one "approved, neutral for all four
 * 60-minute purchases". CLAUDE.md lists the same three URLs.
 *
 * WHY THE ?p= PARAMETER.
 *
 * Four products share the 60-minute page and two share the leadership page, so
 * §08's copy had to be neutral — a shared page must never name the wrong
 * product. But neutral left two real problems:
 *
 *   1. A £640 four-session buyer saw only "Now let's schedule your session",
 *      and had to decide for themselves whether a paragraph beginning "If you
 *      purchased a multi-session package or path" was about them.
 *   2. Darlene's calendar showed a 60-minute booking with no way to tell a
 *      one-off client from session 1 of a package, short of cross-referencing
 *      every booking against Stripe by hand.
 *
 * Stripe allows a query string on the redirect URL, so each Payment Link now
 * carries its own product id. Still three pages; the page simply knows which
 * of its products it is serving. §08's neutral copy is kept EXACTLY as the
 * fallback for a missing or unrecognised id, so a mistyped Stripe redirect
 * degrades to the approved wording rather than breaking.
 *
 * The id is validated against this page's own product list, so ?p= cannot make
 * a page announce a product that does not schedule here.
 *
 * NO PRICE IS SHOWN. Stripe's receipt already carries the amount, and if a
 * discount code is ever used a hard-coded price here would contradict the
 * actual charge. Being wrong about money on a payment confirmation is worse
 * than saying nothing.
 *
 * AFTER DEPLOYMENT: send Darlene the seven redirect URLs (three pages ×
 * their product ids) so she can set each Stripe Payment Link's "After
 * payment" redirect.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgressSteps from '../../components/ProgressSteps.astro';
import Icon from '../../components/Icon.astro';
import { business, routes, calendly, stripeLinks } from '../../config/site.js';

/* Rendered per request so ?p= is readable. A prerendered page evaluates
   searchParams at build time, where it is always empty. */
export const prerender = false;

/* Master Copy §08, verbatim. `packageNote` is null where §08 says
   "no package language". */
const PAGES = {
  '60-minute-session': {
    route: routes.schedule60,
    calendlyUrl: calendly.session60,
    heading: "Your payment is complete. Now let's schedule your session.",
    body: 'Choose a time below that works for you.',
    packageNote:
      'If you purchased a multi-session package or path: use this page to schedule your first session. We’ll provide simple instructions for scheduling your remaining sessions without additional payment.',
    fallbackLabel: 'Schedule Your 60-Minute Session',
    title: '60-Minute Session Scheduling',
  },
  '90-minute-session': {
    route: routes.schedule90,
    calendlyUrl: calendly.session90,
    heading: "Your payment is complete. Now let's schedule your session.",
    body: 'Choose a time below that works for you.',
    packageNote: null, // §08: "no package language"
    fallbackLabel: 'Schedule Your 90-Minute Session',
    title: '90-Minute Session Scheduling',
  },
  'leadership-session': {
    route: routes.scheduleLeadership,
    calendlyUrl: calendly.leadership75,
    heading: "Your payment is complete. Now let's schedule your leadership session.",
    body: 'Choose a time below that works for you.',
    packageNote:
      'If you purchased the 3-Session Leadership Package: use this page to schedule your first session. We’ll provide simple instructions for scheduling your remaining sessions without additional payment.',
    fallbackLabel: 'Schedule Your Leadership Session',
    title: 'Leadership Session Scheduling',
  },
};

const key = Astro.params.session;
const page = PAGES[key];

if (!page) return Astro.redirect(routes.individualSessions, 303);

/* Only products that actually schedule on THIS page may be named by ?p=. */
const product =
  stripeLinks.find(
    (s) => s.id === Astro.url.searchParams.get('p') && s.scheduling === page.route,
  ) ?? null;

const isPackage = product?.isPackage ?? false;

/* Tag the booking so Darlene's Calendly notification says which product it is,
   instead of an anonymous 60-minute slot. Calendly stores UTM parameters
   against the booking and includes them in exports and webhooks. */
const embedUrl = product
  ? `${page.calendlyUrl}?utm_source=starting-point&utm_medium=post-payment&utm_content=${encodeURIComponent(product.name)}`
  : page.calendlyUrl;
---

<BaseLayout
  title={`${page.title} | ${business.name}`}
  description="Schedule your session."
  noindex
>
  <section class="section schedule">
    <div class="container schedule__inner">
      <ProgressSteps current={2} packageLabel={isPackage} />

      {/* Blueprints Page 06 §3: the confirmation block. */}
      <div class="schedule__confirm">
        <span class="schedule__mark" aria-hidden="true">
          <Icon name="check" size={30} />
        </span>
        <h1>{page.heading}</h1>

        {
          product && (
            <p class="schedule__product">
              {product.name}
              {isPackage && product.sessions && (
                <span class="schedule__of"> · scheduling session 1 of {product.sessions}</span>
              )}
            </p>
          )
        }

        <p class="t-lead schedule__body">{page.body}</p>
      </div>

      {
        /* Known package: say it plainly, in §08's words minus the conditional.
           Known single session: nothing to say. Unknown: §08 verbatim. */
        product ? (
          isPackage && (
            <div class="schedule__package">
              <p>
                Use this page to schedule your first session. We’ll provide simple instructions for
                scheduling your remaining sessions without additional payment.
              </p>
            </div>
          )
        ) : (
          page.packageNote && (
            <div class="schedule__package">
              <p>{page.packageNote}</p>
            </div>
          )
        )
      }

      {/* Calendly owns the calendar itself. */}
      <div
        class="calendly-inline-widget schedule__embed"
        data-url={embedUrl}
        data-auto-load="false"
      >
      </div>

      <noscript>
        <p class="schedule__fallback">
          Scheduling runs on Calendly, which needs JavaScript.
          <a href={embedUrl} target="_blank" rel="noopener noreferrer">{page.fallbackLabel}</a>, or
          <a href={routes.contact}>send us a message</a> and we’ll arrange a time.
        </p>
      </noscript>

      <p class="schedule__fallback">
        <a href={embedUrl} target="_blank" rel="noopener noreferrer">
          Trouble with the calendar? {page.fallbackLabel}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .schedule {
    background: var(--surface-page);
  }

  .schedule__inner {
    max-width: 860px;
  }

  .schedule__confirm {
    text-align: center;
  }

  /* Blueprints Page 06 §4: "Gold Check plate". */
  .schedule__mark {
    display: inline-grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: var(--gold-50);
    color: var(--gold-700);
    border: 1px solid var(--gold-200);
  }

  .schedule__confirm h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* What they bought, so a package buyer is never left guessing. */
  .schedule__product {
    margin-top: 14px;
    font-family: var(--heading-font);
    font-weight: var(--fw-semibold);
    font-size: var(--text-md);
    color: var(--text-strong);
  }

  .schedule__of {
    font-weight: var(--fw-regular);
    color: var(--text-muted);
  }

  .schedule__body {
    margin: 12px auto 0;
    max-width: 46ch;
  }

  .schedule__package {
    margin-top: 28px;
    padding: 18px 20px;
    border-radius: var(--radius-md);
    background: var(--gold-50);
    border: 1px solid var(--gold-200);
    line-height: 1.6;
    color: var(--text-body);
  }

  .schedule__embed {
    margin-top: 28px;
    min-width: 0;
    height: 700px;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
  }

  .schedule__fallback {
    margin-top: 12px;
    text-align: center;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .schedule__embed {
      height: 640px;
    }
  }
</style>

<script>
  // Same pattern as the booking page: Calendly's script is loaded here so it
  // only runs on this page, and a failure leaves a usable link rather than an
  // empty frame. Someone who has just paid must never be stranded.
  const container = document.querySelector<HTMLElement>('.calendly-inline-widget');

  if (container) {
    const styles = document.createElement('link');
    styles.rel = 'stylesheet';
    styles.href = 'https://assets.calendly.com/assets/external/widget.css';
    document.head.append(styles);

    const script = document.createElement('script');
    script.src = 'https://assets.calendly.com/assets/external/widget.js';
    script.async = true;

    script.addEventListener('load', () => {
      const calendly = (window as unknown as { Calendly?: { initInlineWidget(o: object): void } })
        .Calendly;
      calendly?.initInlineWidget({ url: container.dataset.url, parentElement: container });
    });

    script.addEventListener('error', () => {
      container.innerHTML = '';
      container.style.display = 'grid';
      container.style.placeItems = 'center';
      container.style.padding = '24px';
      container.textContent =
        'The scheduling calendar could not load. Use the link below to book your time.';
    });

    document.head.append(script);
  }
</script>
