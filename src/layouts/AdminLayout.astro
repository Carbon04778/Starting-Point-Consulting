---
/**
 * Shell for the private admin area. Same design tokens as the public site,
 * but its own chrome: no public header/footer, no marketing nav, no
 * structured data, always noindex.
 *
 * Nothing under this layout is reachable without passing src/middleware.js,
 * except the login page, which passes `bare`.
 */
import { business } from '../config/site.js';
import '../styles/global.css';

interface Props {
  title: string;
  /** Login page: no nav, no sign-out. */
  bare?: boolean;
  /** Which nav item is current. */
  section?: 'articles' | 'photos' | 'intake' | 'acceptances';
  adminEmail?: string;
}

const { title, bare = false, section, adminEmail } = Astro.props;

const nav = [
  { key: 'articles', label: 'Articles', href: '/admin' },
  { key: 'photos', label: 'Photos', href: '/admin/photos' },
  { key: 'intake', label: 'Intake submissions', href: '/admin/intake' },
  { key: 'acceptances', label: 'Agreement acceptances', href: '/admin/acceptances' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Admin · {business.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo/starting-point-favicon-32x32.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="admin">
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="admin-bar">
      <div class="admin-bar__inner">
        <a class="admin-bar__brand" href={bare ? '/admin/login' : '/admin'}>
          <img src="/assets/logo/starting-point-horizontal-2000x771.svg" alt={business.name} width="156" height="60" />
          <span class="admin-bar__label">Admin</span>
        </a>

        {
          !bare && (
            <>
              <nav class="admin-bar__nav" aria-label="Admin sections">
                {nav.map((item) => (
                  <a href={item.href} aria-current={item.key === section ? 'page' : undefined}>
                    {item.label}
                  </a>
                ))}
              </nav>
              <form class="admin-bar__session" method="POST" action="/api/admin/logout">
                {adminEmail && <span class="admin-bar__who">{adminEmail}</span>}
                <button class="btn btn--text" type="submit">Sign out</button>
              </form>
            </>
          )
        }
      </div>
    </header>

    <main id="main" class="admin-main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body.admin {
    background: var(--wash-cream);
  }

  .admin-bar {
    background: var(--surface-card);
    border-bottom: 1px solid var(--hairline);
  }

  .admin-bar__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 12px var(--gutter);
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .admin-bar__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .admin-bar__brand img {
    height: 44px;
    width: auto;
  }

  .admin-bar__label {
    font-family: var(--font-display);
    font-size: var(--text-2xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--gold-700);
    padding: 4px 8px;
    border: 1px solid var(--gold-200);
    border-radius: var(--radius-pill);
  }

  .admin-bar__nav {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .admin-bar__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 8px 14px;
    border-radius: var(--radius-button);
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: var(--text-sm);
    color: var(--text-body);
    text-decoration: none;
  }

  .admin-bar__nav a:hover {
    background: var(--sand-100);
  }

  .admin-bar__nav a[aria-current='page'] {
    background: var(--gold-50);
    color: var(--gold-700);
  }

  .admin-bar__session {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .admin-bar__who {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .admin-main {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 40px var(--gutter) 88px;
  }

  /* Shared admin pieces */
  .admin-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .admin-head h1 {
    font-size: var(--text-2xl);
    margin: 0;
  }

  .admin-head p {
    margin: 8px 0 0;
    color: var(--text-muted);
    max-width: 60ch;
  }

  .admin-notice {
    padding: 14px 18px;
    border-radius: var(--radius-button);
    margin-bottom: 24px;
    font-size: var(--text-base);
  }

  .admin-notice--ok {
    background: var(--gold-50);
    border: 1px solid var(--gold-100);
    color: var(--text-body);
  }

  .admin-notice--error {
    background: #fbeeee;
    border: 1px solid var(--danger-500);
    color: var(--text-body);
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    overflow: hidden;
    font-size: var(--text-sm);
  }

  .admin-table th,
  .admin-table td {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }

  .admin-table th {
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--sand-50);
  }

  .admin-table tr:last-child td {
    border-bottom: 0;
  }

  .admin-table-wrap {
    overflow-x: auto;
  }

  .status-pill {
    display: inline-flex;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--fw-medium);
  }

  .status-pill--published {
    background: var(--sage-50);
    color: var(--sage-700);
  }

  .status-pill--draft {
    background: var(--sand-100);
    color: var(--text-muted);
  }

  .admin-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .admin-card {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: var(--card-pad);
  }

  @media (max-width: 768px) {
    .admin-bar__session {
      margin-left: 0;
    }

    .admin-card {
      padding: var(--card-pad-mobile);
    }
  }
</style>
