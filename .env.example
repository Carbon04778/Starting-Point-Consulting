# Starting Point Consulting — environment variables.
#
# Copy to `.env` and fill in. Never commit `.env`.
#
# CLAUDE.md, "Hosting and ownership model": the build lives on Hadley's
# accounts now and transfers to accounts Darlene owns at completion. Nothing
# account-specific is hardcoded in app logic — it all comes from here, so the
# transfer is a matter of swapping these values.

# --- Supabase (added in Phase 5; the schema and RLS policies must be
#     approved in plain English before any of this is used) ---

# Safe to expose to the browser. Reads only what RLS allows anonymously.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never import this into client-side code and never prefix it
# with PUBLIC_. Used by the server endpoints that log Client Service Agreement
# acceptances and store New Client Intake submissions.
SUPABASE_SERVICE_ROLE_KEY=
